<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
    <mime-type type="application/x-apple-diskimage">
        <sub-class-of type="application/octet-stream"/>

        <comment>Apple Disk image</comment>
        <comment xml:lang="ru">Образ Apple Disk</comment>
        <comment xml:lang="sl">Apple Disk odtis trdega diska</comment>

        <glob pattern="*.cdr"/>
        <glob pattern="*.smi"/>
        <glob weight="20" pattern="*.img"/>
        <glob pattern="*.dmg"/>

        <magic priority="50">
            <match value="koly" type="string" offset="0"/>
        </magic>
    </mime-type>
</mime-info>